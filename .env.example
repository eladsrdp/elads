# ===== הגדרות סביבה - צוות הסוכנים =====
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים.
# אל תעלה את .env ל-git! (הוא מוחרג ב-.gitignore)

# מפתח Anthropic API - מפעיל את ראובן ואת כל הסוכנים (Claude)
ANTHROPIC_API_KEY=

# יצירת תמונות עבור יובל (מעצב התמונות) - skill: gpt-image-gen
OPENAI_API_KEY=

# אופציונלי - חיפוש/מחקר באינטרנט עבור חן (החוקרת)
# TAVILY_API_KEY=

# הוצאת חשבוניות עבור נועה (מזכירת החשבוניות) - skill: webenefit-invoice
# טוקן מתקבל מ-WeBenefit (info@webenefit.co.il), לא OAuth self-service
WEBENEFIT_ACCESS_TOKEN=
