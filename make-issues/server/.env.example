# הגדרות שרת — העתק ל-.env ומלא ערכים אמיתיים. בפיתוח אפשר לרוץ בלי .env בכלל (נופל ל-DB מקומי בקובץ).

PORT=8787
NODE_ENV=development

# חתימת ה-access token (JWT). בפרודקשן חובה ערך אקראי ארוך!
JWT_SECRET=dev-secret-change-me

# secret משותף עם Make.com — כל HTTP module ב-Error Handler שולח אותו ב-Authorization: Bearer <ערך>
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Neon (Postgres serverless) — אם ממולא, זו העדיפות הראשונה (מתאים ל-Vercel — filesystem לא מתמיד).
# מחרוזת חיבור מלאה מ-Neon (Project → Connection string), כוללת סיסמה — לעולם לא ל-git.
DATABASE_URL=

# Supabase — חלופה ל-Neon (עדיפות שנייה). אם שני האלה ריקים, השרת נופל אוטומטית ל-DB מקומי
# בקובץ (./data/local-db.json, מתמיד בין הרצות, ללא תלות בענן) — מתאים לפיתוח מקומי בלבד.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
